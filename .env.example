# Supabase Configuration
# Set these as environment variables on Render - the server exposes them to the
# browser through /api/config. You can still override them per-browser using the
# in-app Cloud Sync (Supabase) settings menu.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-api-key-here
